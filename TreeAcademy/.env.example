# Leave blank for local development: Vite proxies /api to the Express server.
# In production, set this only when the API uses a separate domain.
VITE_PAYMENT_API_URL=

# Backend SMTP settings (for Gmail, use an App Password—not your Gmail password).
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Tree Academy <your-sending-address@gmail.com>
